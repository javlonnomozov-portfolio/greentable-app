{
  "name": "greentable-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "vite build --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dayjs": "^1.11.23",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wouter": "^3.13.0"
  }
}
